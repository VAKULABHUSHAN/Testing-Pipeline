# ==================================================
# Mobile Sentinel - Comprehensive .gitignore
# ==================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
wheels/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
.installed.cfg
*.egg

# Virtual environments
/.venv/
/venv/
/env/
/ENV/

# IDE & Editors
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Environment / secrets
.env
.env.*
!.env.example

# Local configuration containing secrets
/config/local/
/config/secrets/
/config/*-auth.yaml
!/config/*-auth.example.yaml
/config/*.local.yaml
/secrets/
/credentials/
*.secret
*.secrets
*.key
*.pem
*.p12
*.jks
*.keystore

# Mobile Sentinel generated reports
/reports/*
!/reports/.gitkeep
/report/
/scan-results/
/results/

# Runtime evidence
/evidence/
/artifacts/*
!/artifacts/.gitkeep
/screenshots/
/logs/

# Root-level runtime/device data
/runtime/
/device-data/
/adb/
/captures/

# Databases generated by Sentinel
*.db
*.sqlite
*.sqlite3

# Temporary files
/tmp/
/temp/*
!/temp/.gitkeep
*.tmp
*.temp
*.log

# APKs / Android artifacts
*.apk
*.aab
*.apks
*.xapk
*.dex
*.class

# Decompiled APK output
decompiled/
apktool/
jadx-output/
smali/
smali_classes*/

# Android build artifacts
android/.gradle/
android/build/
android/app/build/
.gradle/

# Flutter artifacts
.flutter-plugins
.flutter-plugins-dependencies
.dart_tool/
.pub-cache/
.packages

# Coverage
coverage/

# Generated documentation/output
site/
docs/_build/

# Local test data
/test_data/local/
/fixtures/local/

# Machine-specific files
*.local
local.*
